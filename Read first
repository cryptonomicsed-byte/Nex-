import { spawn } from 'child_process';
import { promisify } from 'util';

export interface AgentDNA {
  agent_id: string;
  mnemonic: string;
  odù_index: number;
  dominant_orisha: string;
  elemental_signature: Record<string, number>;
  personality_summary: string;
}

export class Bipon39Bridge {
  private binaryPath: string;

  constructor(binaryPath: string = './Bipon39-Rust-/target/release/bipon39') {
    this.binaryPath = binaryPath;
  }

  async deriveIdentity(entropy: Buffer): Promise<AgentDNA> {
    const mnemonic = await this.call('entropy_to_mnemonic', entropy.toString('hex'));
    const profile = await this.call('inspect', mnemonic);
    return {
      agent_id: `0x${Buffer.from(mnemonic).toString('hex').slice(0, 40)}`,
      mnemonic,
      odù_index: profile.odù_index,
      dominant_orisha: profile.dominant_orisha,
      elemental_signature: profile.elements,
      personality_summary: profile.summary,
    };
  }

  private async call(command: string, ...args: string[]): Promise<any> {
    return new Promise((resolve, reject) => {
      const proc = spawn(this.binaryPath, [command, ...args]);
      let output = '';
      proc.stdout.on('data', (d) => { output += d; });
      proc.on('close', (code) => {
        if (code !== 0) reject(new Error(`Bipon39 exited ${code}`));
        else resolve(JSON.parse(output));
      });
    });
  }
}
